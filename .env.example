# --- Litestar API (local single-user app; keep it on loopback) ---
API_HOST=127.0.0.1
API_PORT=8080

# --- Streamlit client -> API base URL ---
STREAMLIT_API_URL=http://127.0.0.1:8080

# --- Model backend: "vllm" (default) or "openai" (temporary workaround) ---
MODEL_BACKEND=vllm

# Required when MODEL_BACKEND=vllm
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct

# Required only when MODEL_BACKEND=openai
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-4o-mini

# --- Qdrant (externally populated, read-only) ---
QDRANT_URL=http://127.0.0.1:6333
#QDRANT_API_KEY=
QDRANT_COLLECTION=corpus
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# --- Retrieval models (must match the collection's vector contract) ---
DENSE_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Optional LangSmith tracing (may include prompts, passages, and outputs) ---
LANGSMITH_TRACING=false
#LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#LANGSMITH_PROJECT=ragchat

# --- Sandbox: "disabled" (default) or "docker" ---
SANDBOX_MODE=disabled
SANDBOX_IMAGE=ragchat-sandbox:latest
SANDBOX_COMMAND_TIMEOUT_SECONDS=60
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_PIDS_LIMIT=128
SANDBOX_OUTPUT_LIMIT_CHARS=20000
# Inline image artifacts larger than this many raw bytes are skipped.
ARTIFACT_MAX_BYTES=5000000
